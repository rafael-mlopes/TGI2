# Copie para ".env" (mesma pasta do docker-compose.yml) e troque os valores.
# O arquivo .env NÃO é versionado. Sem ele, o Compose usa os valores padrão de desenvolvimento.

# Banco MySQL (só têm efeito na PRIMEIRA criação do volume mysql_data)
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
TGI_DB_PASSWORD=troque_esta_senha

# Broker MQTT (usuário/senha exigidos de todos os clientes)
TGI_MQTT_USER=tgi_mqtt
TGI_MQTT_PASSWORD=troque_esta_senha_mqtt

# Retenção (dias) do histórico técnico nas tabelas CLP_* (0 desativa a limpeza)
TGI_RETENCAO_DIAS=30

# URL da API usada pelo front-end (é embutida no build do React)
VITE_API_URL=http://localhost:5000
